    else:  
        for _, row in supported.head(10).iterrows():  
            st.markdown(  
                f"**{row['Attribute']}** — "  
                f"Sample size: {int(row['Sample size'])}; "  
                f"CTR correlation: "  
                f"{row['Spearman correlation']:.3f}; "  
