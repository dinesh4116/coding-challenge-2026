ATTRIBUTE_NAMES = [
"red_background",
"blue_background",
"green_background",
"dark_background",
"light_background",
"has_text",
"text_area_ratio",
"brightness",
"contrast",
"saturation",
"red_ratio",
"blue_ratio",
"green_ratio",
"warm_color_ratio",
"edge_density",
"aspect_ratio",
"image_area"
]

def extract_image_features(image_path):
image = Image.open(image_path).convert("RGB")
image.thumbnail((256, 256))

pixels = np.asarray(image, dtype=np.float32) / 255.0  
red = pixels[:, :, 0]  
green = pixels[:, :, 1]  
blue = pixels[:, :, 2]  

brightness = float(np.mean(pixels))  
contrast = float(np.std(pixels))  

saturation = (  
    np.max(pixels, axis=2) - np.min(pixels, axis=2)  
)  

red_ratio = float(np.mean(  
    (red > green * 1.15) & (red > blue * 1.15)  
))  
blue_ratio = float(np.mean(  
    (blue > red * 1.15) & (blue > green * 1.05)  
))  
green_ratio = float(np.mean(  
    (green > red * 1.10) & (green > blue * 1.10)  
))  

gray = np.mean(pixels, axis=2)  

edge_x = np.abs(np.diff(gray, axis=1))  
edge_y = np.abs(np.diff(gray, axis=0))  

edge_density = float(  
    (np.mean(edge_x > 0.1) + np.mean(edge_y > 0.1)) / 2  
)  

height, width = pixels.shape[:2]  

return {  
    "red_background": int(  
        red_ratio > 0.35 and brightness > 0.2  
    ),  
    "blue_background": int(blue_ratio > 0.35),  
    "green_background": int(green_ratio > 0.35),  
    "dark_background": int(brightness < 0.35),  
    "light_background": int(brightness > 0.65),  
    "has_text": 0,  
    "text_area_ratio": 0.0,  
    "brightness": brightness,  
    "contrast": contrast,  
    "saturation": float(np.mean(saturation)),  
    "red_ratio": red_ratio,  
    "blue_ratio": blue_ratio,  
    "green_ratio": green_ratio,  
    "warm_color_ratio": float(np.mean(  
        (red > blue * 1.15) & (green > blue * 1.05)  
    )),  
    "edge_density": edge_density,  
    "aspect_ratio": width / max(height, 1),  
    "image_area": width * height  
}

def calculate_metrics(data):
data = data.copy()

data["ctr"] = np.where(  
    data["impressions"] > 0,  
    data["clicks"] / data["impressions"] * 100,  
    np.nan  
)  

data["conversion_rate"] = np.where(  
    data["clicks"] > 0,  
    data["conversions"] / data["clicks"] * 100,  
    np.nan  
)  

data["cpc"] = np.where(  
    data["clicks"] > 0,  
    data["spend"] / data["clicks"],  
    np.nan  
)  

data["cpa"] = np.where(  
    data["conversions"] > 0,  
    data["spend"] / data["conversions"],  
    np.nan  
)  

return data

def load_data():
if not METRICS_FILE.exists():
return pd.DataFrame()

data = pd.read_csv(METRICS_FILE)  

required = [  
    "creative_id",  
    "spend",  
    "impressions",  
    "clicks",  
    "conversions"  
]  

if not all(column in data.columns for column in required):  
    st.error(  
        "The CSV must contain creative_id, spend, impressions, "  
        "clicks, and conversions."  
    )  
    return pd.DataFrame()  

data["creative_id"] = data["creative_id"].astype(str)  
return data

def analyze_attributes(data):
results = []

for attribute in ATTRIBUTE_NAMES:  
    if attribute not in data.columns:  
        continue  

    subset = data[  
        [attribute, "ctr", "conversion_rate", "conversions"]  
    ].dropna()  

    if len(subset) < 5 or subset[attribute].nunique() < 2:  
        results.append({  
            "Attribute": attribute,  
            "Sample size": len(subset),  
            "Effect size": np.nan,  
            "Spearman correlation": np.nan,  
            "P-value": np.nan,  
            "Confidence": "Insufficient data"  
        })  
        continue  

    correlation, p_value = spearmanr(  
        subset[attribute],  
        subset["ctr"]  
    )  

    groups = subset.groupby(  
        subset[attribute] > subset[attribute].median()  
    )["ctr"].mean()  

    effect = (  
        groups.get(True, np.nan) - groups.get(False, np.nan)  
    )  

    if len(subset) < 30:  
        confidence = "Low"  
    elif p_value < 0.05:  
        confidence = "Potential association"  
    else:  
        confidence = "Uncertain"  

    results.append({  
        "Attribute": attribute,  
        "Sample size": len(subset),  
        "Effect size": effect,  
        "Spearman correlation": correlation,  
        "P-value": p_value,  
        "Confidence": confidence  
    })  

result = pd.DataFrame(results)  

if not result.empty:  
    result["Absolute correlation"] = (  
        result["Spearman correlation"].abs()  
    )  
    result = result.sort_values(  
        "Absolute correlation",  
        ascending=False,  
        na_position="last"  
    )  

return result

def create_sample_data():
rng = np.random.default_rng(42)
count = 150

sample = pd.DataFrame({  
    "creative_id": [f"AD_{i:03d}" for i in range(1, count + 1)],  
    "spend": rng.uniform(100, 5000, count),  
    "impressions": rng.integers(5000, 100000, count),  
    "clicks": rng.integers(50, 3000, count),  
    "conversions": rng.integers(1, 250, count)  
})  

for attribute in ATTRIBUTE_NAMES:  
    if attribute in sample.columns:  
        continue  

    if attribute in [  
        "red_background", "blue_background",  
        "green_background", "dark_background",  
        "light_background", "has_text"  
    ]:  
        sample[attribute] = rng.integers(0, 2, count)  
    else:  
        sample[attribute] = rng.uniform(0, 1, count)  

sample.to_csv(METRICS_FILE, index=False)  
return sample

