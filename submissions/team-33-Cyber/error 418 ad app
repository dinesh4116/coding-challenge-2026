                f"Status: {row['Confidence']}"  
            )  

st.divider()  

st.subheader("Creative Brief Suggestions")  

if not results.empty:  
    reliable = results[  
        (results["Sample size"] >= 30)  
        & (results["P-value"] < 0.05)  
        & results["Spearman correlation"].notna()  
    ]  

