    st.warning("No attributes are available for analysis.")  
else:  
    st.dataframe(results, use_container_width=True)  

    supported = results[  
        results["Sample size"] >= 30  
    ].copy()  

    st.subheader("Ranked Findings")  

    if supported.empty:  
        st.warning(  
            "No finding has at least 30 usable observations. "  
            "Collect more data before making strong conclusions."  
