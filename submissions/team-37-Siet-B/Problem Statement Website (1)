:root { font-family: "DM Sans", sans-serif; color: rgb(20, 43, 53); background: rgb(246, 248, 247); font-synthesis: none; }

* { box-sizing: border-box; }

body { margin: 0px; min-width: 320px; }

button, input { font: inherit; }

button { cursor: pointer; }

.app-shell { min-height: 100vh; display: flex; background: rgb(246, 248, 247); }

.sidebar { width: 248px; flex: 0 0 248px; background: rgb(255, 255, 255); border-right: 1px solid rgb(228, 234, 232); padding: 27px 16px 18px; display: flex; flex-direction: column; }

.brand { display: flex; align-items: center; gap: 10px; padding: 0px 13px 31px; font-family: "Space Grotesk"; font-weight: 700; font-size: 20px; letter-spacing: -0.5px; color: rgb(23, 57, 67); }

.brand-mark { width: 29px; height: 29px; display: grid; place-items: center; color: rgb(255, 255, 255); background: rgb(29, 117, 101); border-radius: 8px; box-shadow: rgba(29, 117, 101, 0.2) 0px 4px 10px; }

.workspace-switcher { background: rgb(245, 248, 247); border: 1px solid rgb(230, 236, 234); border-radius: 11px; padding: 10px; display: flex; align-items: center; gap: 9px; font-size: 11px; margin: 0px 4px 28px; }

.workspace-avatar, .profile-avatar { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; color: rgb(21, 89, 78); background: rgb(214, 238, 234); font-size: 10px; font-weight: 700; }

.workspace-switcher div:nth-child(2), .profile div:nth-child(2) { flex: 1 1 0%; min-width: 0px; }

.workspace-switcher strong, .profile strong { display: block; color: rgb(24, 52, 60); font-size: 11px; font-weight: 700; white-space: nowrap; }

.workspace-switcher span, .profile span { display: block; color: rgb(138, 155, 156); margin-top: 3px; font-size: 10px; white-space: nowrap; }

.side-nav { flex: 1 1 0%; }

.nav-label { color: rgb(162, 175, 174); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; padding: 0px 13px; margin: 0px 0px 9px; }

.nav-label-spaced { margin-top: 30px; }

.nav-item { width: 100%; border: 0px; background: transparent; color: rgb(120, 144, 142); display: flex; align-items: center; gap: 13px; padding: 10px 13px; border-radius: 8px; font-size: 13px; margin: 3px 0px; text-align: left; transition: 0.2s; }

.nav-item:hover { color: rgb(29, 117, 101); background: rgb(240, 247, 245); }

.nav-item.active { color: rgb(21, 95, 83); background: rgb(231, 242, 239); font-weight: 700; }

.nav-item b { margin-left: auto; font-size: 10px; font-weight: 600; color: rgb(123, 153, 149); background: rgb(217, 235, 231); padding: 3px 6px; border-radius: 5px; }

.upgrade-card { padding: 15px; background: rgb(23, 63, 69); border-radius: 11px; color: rgb(255, 255, 255); position: relative; overflow: hidden; }

.upgrade-card::after { content: ""; position: absolute; width: 100px; height: 100px; right: -35px; top: -42px; border: 1px solid rgba(166, 230, 215, 0.333); border-radius: 50%; box-shadow: rgba(166, 230, 213, 0.067) 0px 0px 0px 12px, rgba(166, 230, 213, 0.03) 0px 0px 0px 25px; }

.upgrade-icon { color: rgb(164, 227, 211); margin-bottom: 12px; }

.upgrade-card strong { display: block; font-size: 12px; }

.upgrade-card p { color: rgb(185, 208, 206); font-size: 10px; line-height: 1.5; margin: 5px 0px 12px; }

.upgrade-card button { border: 0px; color: rgb(164, 227, 211); background: none; padding: 0px; display: flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; }

.profile { display: flex; align-items: center; gap: 9px; border-top: 1px solid rgb(237, 241, 240); margin: 18px 0px 0px; padding: 17px 6px 0px; }

.profile-avatar { width: 30px; height: 30px; border-radius: 50%; background: rgb(242, 221, 209); color: rgb(143, 89, 66); }

.profile > svg { color: rgb(154, 168, 167); }

.main-content { flex: 1 1 0%; min-width: 0px; }

.topbar { height: 72px; padding: 0px 42px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(231, 237, 235); background: rgb(251, 252, 252); }

.breadcrumbs { display: flex; gap: 11px; font-size: 12px; color: rgb(154, 171, 168); }

.breadcrumbs strong { color: rgb(54, 87, 90); font-weight: 600; }

.topbar-actions { display: flex; align-items: center; gap: 12px; }

.icon-button, .row-menu, .close-button { background: transparent; border: 0px; color: rgb(121, 144, 142); padding: 7px; border-radius: 7px; }

.icon-button:hover, .row-menu:hover, .close-button:hover { background: rgb(237, 244, 242); color: rgb(29, 117, 101); }

.topbar-avatar { height: 31px; width: 31px; border-radius: 50%; background: rgb(242, 221, 209); color: rgb(143, 89, 66); display: grid; place-items: center; font-size: 10px; font-weight: 700; margin-left: 4px; }

.bell-dot { position: relative; display: flex; }

.bell-dot i { position: absolute; top: 3px; right: 2px; width: 5px; height: 5px; background: rgb(229, 140, 108); border: 1px solid rgb(251, 252, 252); border-radius: 50%; }

.mobile-menu { display: none; }

.page-content { padding: 37px 42px 60px; max-width: 1440px; margin: 0px auto; }

.page-heading { display: flex; justify-content: space-between; align-items: end; margin-bottom: 30px; }

.eyebrow { color: rgb(122, 153, 148); font-size: 10px; font-weight: 700; letter-spacing: 1.1px; display: flex; align-items: center; gap: 7px; margin-bottom: 12px; }

.status-dot { width: 6px; height: 6px; background: rgb(65, 179, 154); border-radius: 50%; box-shadow: rgb(223, 242, 237) 0px 0px 0px 4px; }

.page-heading h1, .empty-view h1 { font-family: "Space Grotesk"; color: rgb(22, 61, 69); font-size: 30px; line-height: 1.2; letter-spacing: -1.2px; margin: 0px; }

.heading-period { color: rgb(230, 140, 109); }

.page-heading p, .empty-view p { color: rgb(128, 145, 143); font-size: 13px; margin: 9px 0px 0px; }

.primary-button { border: 0px; border-radius: 8px; background: rgb(29, 117, 101); color: rgb(255, 255, 255); padding: 11px 16px; display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; box-shadow: rgba(29, 117, 101, 0.15) 0px 6px 14px; transition: 0.2s; }

.primary-button:hover { background: rgb(24, 95, 83); transform: translateY(-1px); }

.primary-button:disabled { opacity: 0.7; cursor: wait; transform: none; }

.metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 17px; }

.metric-card { background: rgb(255, 255, 255); border: 1px solid rgb(229, 236, 233); border-radius: 11px; padding: 17px 18px 15px; }

.metric-top { display: flex; justify-content: space-between; color: rgb(132, 151, 149); font-size: 11px; font-weight: 500; }

.metric-icon { color: rgb(80, 151, 138); background: rgb(237, 247, 244); width: 29px; height: 29px; display: grid; place-items: center; border-radius: 7px; }

.metric-value { color: rgb(21, 62, 70); font-family: "Space Grotesk"; font-size: 30px; letter-spacing: -1px; margin: 13px 0px 7px; }

.metric-value small { font-family: "DM Sans"; font-weight: 500; font-size: 13px; letter-spacing: 0px; color: rgb(150, 166, 164); margin-left: 2px; }

.metric-trend { display: flex; align-items: center; gap: 4px; color: rgb(139, 160, 156); font-size: 10px; }

.metric-trend strong { font-size: 10px; }

.metric-trend.up strong, .metric-trend.up svg { color: rgb(46, 154, 126); }

.metric-trend.down strong, .metric-trend.down svg { color: rgb(226, 127, 97); }

.metric-trend span { margin-left: 2px; }

.content-grid { display: grid; grid-template-columns: minmax(0px, 1.56fr) minmax(320px, 1fr); gap: 17px; margin-bottom: 17px; }

.panel { background: rgb(255, 255, 255); border: 1px solid rgb(229, 236, 233); border-radius: 11px; padding: 21px 22px; }

.panel-heading { display: flex; justify-content: space-between; align-items: flex-start; }

.panel-heading h2 { font-family: "Space Grotesk"; margin: 0px; color: rgb(26, 65, 72); font-size: 15px; letter-spacing: -0.2px; }

.panel-heading p { font-size: 11px; color: rgb(141, 160, 157); margin: 6px 0px 0px; }

.select-button, .filter-button { display: flex; align-items: center; gap: 8px; border: 1px solid rgb(225, 234, 231); color: rgb(96, 124, 121); background: rgb(255, 255, 255); font-size: 10px; padding: 8px 10px; border-radius: 6px; }

.chart-wrap { display: flex; height: 223px; padding-top: 24px; }

.y-axis { width: 30px; display: flex; flex-direction: column; justify-content: space-between; color: rgb(163, 177, 175); font-size: 9px; padding: 0px 0px 28px; }

.chart-area { flex: 1 1 0%; position: relative; }

.grid-lines { position: absolute; inset: 0px 0px 28px; display: flex; flex-direction: column; justify-content: space-between; }

.grid-lines i { display: block; border-top: 1px dashed rgb(230, 239, 236); }

.line-chart { width: 100%; height: calc(100% - 28px); position: relative; overflow: visible; }

.x-axis { display: flex; justify-content: space-between; color: rgb(163, 177, 175); font-size: 9px; padding-top: 3px; }

.chart-legend { border-top: 1px solid rgb(237, 242, 240); display: flex; gap: 20px; padding-top: 15px; color: rgb(134, 153, 151); font-size: 10px; }

.chart-legend span { display: flex; align-items: center; gap: 6px; }

.chart-legend strong { color: rgb(82, 113, 110); font-weight: 600; margin-left: 2px; }

.legend-dot { display: block; width: 7px; height: 7px; border-radius: 50%; }

.legend-dot.teal { background: rgb(29, 117, 101); }

.legend-dot.pale { background: rgb(189, 222, 214); }

.text-button { border: 0px; padding: 3px 0px; background: transparent; color: rgb(50, 136, 120); display: flex; align-items: center; gap: 5px; font-weight: 700; font-size: 10px; }

.attention-list { margin-top: 18px; }

.attention-item { display: flex; align-items: flex-start; gap: 11px; padding: 13px 0px; border-top: 1px solid rgb(237, 242, 240); }

.severity { flex: 0 0 7px; height: 7px; margin-top: 5px; border-radius: 50%; }

.severity.critical { background: rgb(229, 127, 102); box-shadow: rgb(251, 236, 231) 0px 0px 0px 4px; }

.severity.high { background: rgb(231, 173, 84); box-shadow: rgb(251, 242, 223) 0px 0px 0px 4px; }

.severity.medium { background: rgb(117, 168, 160); box-shadow: rgb(227, 240, 237) 0px 0px 0px 4px; }

.attention-item > div { flex: 1 1 0%; min-width: 0px; }

.attention-item strong { display: block; color: rgb(49, 83, 87); font-size: 11px; }

.attention-item p { color: rgb(140, 157, 155); font-size: 10px; margin: 5px 0px; line-height: 1.4; }

.finding-meta { display: flex; gap: 6px; color: rgb(172, 183, 181); font-size: 9px; }

.finding-meta span:first-child { color: rgb(214, 129, 105); }

.item-arrow { color: rgb(166, 181, 178); margin-top: 3px; }

.recent-panel { padding-bottom: 9px; }

.table-wrap { overflow-x: auto; margin-top: 17px; }

table { width: 100%; border-collapse: collapse; white-space: nowrap; }

th { color: rgb(160, 175, 173); font-size: 9px; text-align: left; font-weight: 700; letter-spacing: 0.75px; padding: 0px 10px 11px; }

th:first-child, td:first-child { padding-left: 2px; }

td { color: rgb(98, 127, 123); font-size: 11px; border-top: 1px solid rgb(237, 242, 240); padding: 12px 10px; }

td a { color: rgb(99, 128, 125); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }

td a:hover { color: rgb(29, 117, 101); }

.campaign-cell { display: flex; align-items: center; gap: 9px; color: rgb(44, 81, 85); }

.campaign-logo { width: 25px; height: 25px; border-radius: 7px; display: grid; place-items: center; color: rgb(40, 105, 94); background: rgb(228, 241, 238); font-size: 8px; font-weight: 700; }

.score-cell { display: flex; align-items: center; gap: 9px; }

.score-number { font-weight: 700; font-size: 11px; }

.score-number.good { color: rgb(43, 155, 129); }

.score-number.okay { color: rgb(210, 155, 67); }

.score-number.bad { color: rgb(222, 121, 95); }

.score-bar { width: 45px; height: 4px; border-radius: 5px; background: rgb(234, 240, 238); overflow: hidden; }

.score-bar i { display: block; height: 100%; background: rgb(86, 173, 153); border-radius: 5px; }

.date-cell { color: rgb(148, 165, 162); }

.finding-pill { color: rgb(89, 132, 125); background: rgb(234, 244, 241); border-radius: 5px; padding: 5px 7px; font-size: 9px; }

.finding-pill.warning { color: rgb(199, 126, 94); background: rgb(252, 239, 233); }

.empty-table { text-align: center; padding: 34px; color: rgb(156, 172, 170); }

.audit-library { padding-bottom: 12px; }

.library-toolbar { display: flex; justify-content: space-between; gap: 10px; padding-bottom: 2px; }

.search-box { display: flex; align-items: center; gap: 8px; border: 1px solid rgb(225, 234, 231); border-radius: 7px; padding: 0px 11px; width: 280px; color: rgb(145, 162, 159); }

.search-box input { border: 0px; outline: 0px; padding: 9px 0px; width: 100%; font-size: 11px; color: rgb(55, 89, 83); background: transparent; }

.table-footer { border-top: 1px solid rgb(237, 242, 240); margin-top: 1px; padding: 13px 2px 0px; color: rgb(161, 175, 173); font-size: 10px; display: flex; justify-content: space-between; }

.pagination { display: flex; align-items: center; gap: 10px; }

.pagination button { color: rgb(181, 192, 190); border: 0px; background: none; }

.pagination b { background: rgb(230, 242, 239); color: rgb(36, 115, 98); border-radius: 5px; padding: 4px 7px; }

.empty-view { background: rgb(255, 255, 255); border: 1px solid rgb(229, 236, 233); border-radius: 11px; min-height: 450px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; }

.empty-icon { width: 54px; height: 54px; display: grid; place-items: center; color: rgb(51, 133, 117); background: rgb(232, 244, 241); border-radius: 15px; margin-bottom: 18px; }

.empty-view h1 { font-size: 25px; }

.empty-view .primary-button { margin-top: 24px; }

.modal-backdrop { position: fixed; inset: 0px; background: rgba(23, 59, 59, 0.333); z-index: 10; display: grid; place-items: center; padding: 20px; backdrop-filter: blur(3px); }

.modal { width: min(100%, 465px); background: rgb(255, 255, 255); border-radius: 14px; padding: 25px; box-shadow: rgba(13, 52, 51, 0.2) 0px 20px 70px; }

.modal-header { display: flex; justify-content: space-between; }

.modal-kicker { display: flex; align-items: center; gap: 6px; color: rgb(64, 147, 132); letter-spacing: 1px; font-weight: 700; font-size: 9px; margin-bottom: 10px; }

.modal h2 { font-family: "Space Grotesk"; color: rgb(23, 63, 70); font-size: 21px; margin: 0px; }

.modal-header p { color: rgb(139, 157, 155); font-size: 11px; margin: 7px 0px 21px; }

.close-button { align-self: flex-start; }

.modal form > label { display: block; color: rgb(82, 113, 110); font-size: 11px; font-weight: 700; margin-bottom: 16px; }

.modal input { display: block; width: 100%; margin-top: 7px; border: 1px solid rgb(223, 233, 230); border-radius: 7px; outline: 0px; padding: 11px 12px; color: rgb(49, 86, 90); font-size: 12px; }

.modal input:focus { border-color: rgb(107, 180, 165); box-shadow: rgb(226, 242, 238) 0px 0px 0px 3px; }

.url-field { position: relative; }

.url-field svg { position: absolute; left: 12px; top: 17px; color: rgb(135, 163, 157); }

.url-field input { padding-left: 36px; }

.amount-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }

.modal form > .amount-grid > label { margin-bottom: 0px; }

.amount-field { position: relative; }

.amount-field span { position: absolute; left: 12px; top: 17px; color: rgb(114, 145, 139); font-size: 12px; font-weight: 700; }

.amount-field input { padding-left: 28px; }

.dropzone { display: flex; align-items: center; gap: 11px; border: 1px dashed rgb(185, 214, 208); border-radius: 8px; padding: 13px; background: rgb(246, 251, 250); color: rgb(64, 141, 128); }

.dropzone > div { flex: 1 1 0%; }

.dropzone strong, .dropzone span { display: block; }

.dropzone strong { font-size: 11px; color: rgb(55, 100, 95); }

.dropzone span { font-size: 9px; font-weight: 400; color: rgb(139, 161, 157); margin-top: 3px; }

.dropzone button, .file-button { border: 1px solid rgb(200, 223, 218); color: rgb(56, 130, 116); background: rgb(255, 255, 255); border-radius: 5px; font-size: 9px; font-weight: 700; padding: 7px 8px; white-space: nowrap; cursor: pointer; }

.file-button input { display: none; }

.modal-note { display: flex; align-items: center; gap: 7px; color: rgb(109, 139, 134); font-size: 10px; margin: 18px 0px; }

.modal-note svg { color: rgb(59, 157, 133); }

.modal-submit { width: 100%; justify-content: center; padding: 13px; }

.spin { animation: 1s linear 0s infinite normal none running spin; }

@keyframes spin { 
  100% { transform: rotate(360deg); }
}

.toast { position: fixed; right: 24px; bottom: 24px; z-index: 20; background: rgb(23, 63, 69); color: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(23, 63, 69, 0.22) 0px 8px 22px; padding: 12px 15px; display: flex; align-items: center; gap: 8px; font-size: 12px; animation: 0.25s ease-out 0s 1 normal none running toast-in; }

.toast svg { color: rgb(157, 226, 210); }

@keyframes toast-in { 
  0% { opacity: 0; transform: translateY(8px); }
}

@media (max-width: 1050px) {
  .sidebar { width: 218px; flex-basis: 218px; }
  .topbar, .page-content { padding-left: 28px; padding-right: 28px; }
  .metric-grid { grid-template-columns: repeat(2, 1fr); }
  .content-grid { grid-template-columns: 1fr; }
}

@media (max-width: 720px) {
  .sidebar { display: none; }
  .topbar { height: 62px; padding: 0px 17px; }
  .mobile-menu { display: block; border: 0px; background: none; color: rgb(83, 119, 115); padding: 5px; }
  .topbar-actions { gap: 4px; }
  .breadcrumbs { margin-right: auto; margin-left: 12px; }
  .page-content { padding: 27px 16px 40px; }
  .page-heading { align-items: flex-start; flex-direction: column; gap: 20px; }
  .page-heading h1 { font-size: 26px; }
  .metric-grid { gap: 10px; }
  .metric-card { padding: 13px; }
  .metric-value { font-size: 25px; }
  .content-grid { gap: 12px; }
  .panel { padding: 17px 14px; }
  .panel-heading { gap: 10px; }
  .panel-heading p { line-height: 1.35; }
  .select-button { padding: 7px; }
  .score-panel { overflow: hidden; }
  .chart-wrap { margin-left: -5px; }
  .library-toolbar { flex-direction: column; }
  .search-box { width: 100%; }
  .filter-button { align-self: flex-start; }
  .modal { padding: 20px; }
  .modal-backdrop { padding: 12px; }
}

@media (max-width: 420px) {
  .metric-grid { grid-template-columns: 1fr 1fr; }
  .metric-top { font-size: 10px; }
  .metric-icon { width: 25px; height: 25px; }
  .metric-value { margin-top: 11px; }
  .metric-trend span { display: none; }
  .page-heading .primary-button { width: 100%; justify-content: center; }
  .chart-legend { gap: 10px; }
  .chart-legend span { font-size: 9px; }
  .topbar-avatar { display: none; }
}
